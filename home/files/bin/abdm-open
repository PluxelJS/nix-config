#!/bin/sh
set -eu

# Open AB Download Manager through its tray menu. The app intentionally starts
# in background mode so browser integration and the DMS tray stay in sync.

find_abdm() {
  for candidate in \
    /opt/abdownloadmanager/bin/ABDownloadManager \
    "$HOME/.local/ABDownloadManager/bin/ABDownloadManager"
  do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

exe="$(find_abdm)" || {
  echo "ABDownloadManager executable not found" >&2
  exit 127
}

if ! pgrep -f "$exe" >/dev/null 2>&1; then
  "$HOME/.local/bin/abdm-tray"
  sleep 1
fi

python3 - <<'PY'
import re
import subprocess
import sys

def sh(*args: str) -> str:
    return subprocess.check_output(args, text=True)

def call(*args: str) -> None:
    subprocess.check_call(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

try:
    out = sh(
        "busctl",
        "--user",
        "get-property",
        "org.kde.StatusNotifierWatcher",
        "/StatusNotifierWatcher",
        "org.kde.StatusNotifierWatcher",
        "RegisteredStatusNotifierItems",
    )
except Exception:
    sys.exit(0)

items = re.findall(r'"([^"]+)"', out)
target = None

for entry in items:
    if "/" not in entry:
        continue
    name, raw_path = entry.split("/", 1)
    path = "/" + raw_path
    try:
        title_out = sh(
            "busctl",
            "--user",
            "get-property",
            name,
            path,
            "org.kde.StatusNotifierItem",
            "Title",
        )
    except Exception:
        continue
    if "AB Download Manager" in title_out:
        target = (name, path)
        break

if not target:
    sys.exit(0)

name, path = target

menu_out = sh(
    "busctl",
    "--user",
    "get-property",
    name,
    path,
    "org.kde.StatusNotifierItem",
    "Menu",
)
menu_path_m = re.search(r'"([^"]+)"', menu_out)
if not menu_path_m:
    sys.exit(0)
menu_path = menu_path_m.group(1)

layout_out = sh(
    "busctl",
    "--user",
    "call",
    name,
    menu_path,
    "com.canonical.dbusmenu",
    "GetLayout",
    "iias",
    "0",
    "1",
    "1",
    "label",
)
m = re.search(r"\(ia\{sv\}av\)\s+(\d+)\s+", layout_out)
if not m:
    sys.exit(0)
item_id = m.group(1)

call(
    "busctl",
    "--user",
    "call",
    name,
    menu_path,
    "com.canonical.dbusmenu",
    "Event",
    "isvu",
    item_id,
    "clicked",
    "s",
    "",
    "0",
)
PY
