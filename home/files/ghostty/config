# Font Configuration
font-size = 12

# Window Configuration
window-decoration = false
window-padding-x = 12
window-padding-y = 12
background-opacity = 1.0
background-blur = 32

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 3023

# Terminal features
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# Disable annoying copied to clipboard notifications
app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
#
# Keep the most important shell editing key intact. We allow Ctrl+T for new
# tabs, but leave Ctrl+W to the shell for backward-kill-word.
#
# We also unbind the default Ctrl+Shift+T so the tab model stays single-source:
# Ctrl+T to open, Ctrl+Shift+W to close, Ctrl+PgUp/PgDn to switch.
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+t=unbind
keybind = ctrl+shift+n=new_window
keybind = ctrl+t=new_tab
keybind = ctrl+shift+w=close_tab:this
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+page_up=previous_tab
keybind = ctrl+page_down=next_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Misc
gtk-single-instance = true

# Theme
config-file = ./config-dankcolors
