#!/usr/bin/env bash
set -euo pipefail

app_id="${FLATPAK_ID:-io.github.trumank.CodeStudio}"
program_name="${0##*/}"
shell_mode=0

if [[ "$program_name" == "code-studio-shell" ]]; then
  shell_mode=1
elif [[ "${1:-}" == "--shell" ]]; then
  shell_mode=1
  shift
fi

real_home="${CODE_STUDIO_HOST_HOME:-$HOME}"
if [[ "$real_home" == */.var/app/"$app_id"/home ]]; then
  real_home="${real_home%%/.var/app/"$app_id"/home}"
fi
private_root="$real_home/.var/app/$app_id"
virtual_home="$private_root/home"
config_root="$virtual_home/.config"
share_root="$virtual_home/.local/share"
state_root="$virtual_home/.local/state"
cache_root="$private_root/cache"
tmp_root="$private_root/tmp"
gnupg_home="$virtual_home/.gnupg"
ssh_home="$virtual_home/.ssh"
host_git_config="$real_home/.gitconfig"
user_data_dir="$share_root/code-studio/code-user-data"
user_settings_dir="$user_data_dir/User"
extensions_dir="$virtual_home/.vscode/extensions"
codex_home="$virtual_home/.codex"
zsh_config_dir="$config_root/zsh"
nix_profile="$real_home/.local/state/nix/profiles/profile"
host_code_dir="$real_home/code"
virtual_code_dir="$virtual_home/code"
cli_only=0

# VS Code terminals export VSCODE_* and ELECTRON_* variables. If Code Studio is
# launched from such an environment, those values can redirect to the existing
# editor instance or make Electron run in the wrong mode.
while IFS= read -r env_name; do
  unset "$env_name"
done < <(compgen -A variable VSCODE_)
unset ELECTRON_RUN_AS_NODE ELECTRON_NO_ATTACH_CONSOLE CHROME_DESKTOP

inherited_path="${PATH:-/app/bin:/usr/bin}"

mkdir -p \
  "$virtual_home" \
  "$config_root" \
  "$share_root" \
  "$user_settings_dir" \
  "$extensions_dir" \
  "$state_root" \
  "$tmp_root" \
  "$gnupg_home" \
  "$codex_home" \
  "$ssh_home" \
  "$virtual_home/.cache" \
  "$virtual_home/.local/bin" \
  "$zsh_config_dir" \
  "$config_root/starship"

export HOME="$virtual_home"
export CODE_STUDIO_HOST_HOME="$real_home"
export XDG_CONFIG_HOME="$config_root"
export XDG_DATA_HOME="$share_root"
export XDG_STATE_HOME="$state_root"
export XDG_CACHE_HOME="$cache_root"
export TMPDIR="$tmp_root"
export GNUPGHOME="$gnupg_home"
export CODEX_HOME="$codex_home"
export GIT_CONFIG_GLOBAL="$host_git_config"
export BUN_INSTALL="$virtual_home/.bun"
export NPM_CONFIG_PREFIX="$virtual_home/.local"
export PNPM_HOME="$virtual_home/.local/share/pnpm"
export PNPM_STORE_DIR="$virtual_home/.local/share/pnpm/store"
export MISE_DATA_DIR="$virtual_home/.local/share/mise"
export MISE_CONFIG_DIR="$virtual_home/.config/mise"
export MISE_CACHE_DIR="$virtual_home/.cache/mise"
export ZDOTDIR="$zsh_config_dir"
export SHELL="/app/bin/zsh"
export GIT_SSH_COMMAND="ssh -F $ssh_home/config"
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export ELECTRON_TRASH=gio
unset DISPLAY

mkdir -p \
  "$BUN_INSTALL" \
  "$BUN_INSTALL/bin" \
  "$NPM_CONFIG_PREFIX" \
  "$PNPM_HOME" \
  "$PNPM_STORE_DIR" \
  "$MISE_DATA_DIR" \
  "$MISE_DATA_DIR/shims" \
  "$MISE_CONFIG_DIR" \
  "$MISE_CACHE_DIR" \
  "$ZDOTDIR"

# Keep the private HOME ergonomic without exposing the rest of the host home.
# Flatpak grants writable access to the real ~/code path; this symlink makes
# project paths work naturally as ~/code inside terminals and tools.
if [[ -d "$host_code_dir" ]]; then
  if [[ -L "$virtual_code_dir" ]]; then
    current_code_target="$(readlink "$virtual_code_dir" || true)"
    if [[ "$current_code_target" != "$host_code_dir" ]]; then
      rm -f "$virtual_code_dir"
      ln -s "$host_code_dir" "$virtual_code_dir"
    fi
  elif [[ ! -e "$virtual_code_dir" ]]; then
    ln -s "$host_code_dir" "$virtual_code_dir"
  fi
fi

# GnuPG and OpenSSH reject or warn on group/world-readable private state.
# Flatpak creates app-private paths safely, but nested tool directories are
# still regular user directories, so normalize them before tools like mise run.
chmod 700 "$gnupg_home" "$ssh_home" 2>/dev/null || true

if [[ ! -e "$ssh_home/known_hosts" ]]; then
  : > "$ssh_home/known_hosts"
fi

if [[ ! -e "$ssh_home/config" ]]; then
  {
    printf '# Code Studio defaults\n'
    printf 'Host *\n'
    printf '  UserKnownHostsFile %s\n' "$ssh_home/known_hosts"
    printf '  StrictHostKeyChecking accept-new\n'
  } > "$ssh_home/config"
fi
chmod 600 "$ssh_home/known_hosts" "$ssh_home/config" 2>/dev/null || true

if [[ -d "$nix_profile/bin" ]]; then
  export CODE_STUDIO_NIX_PROFILE="$nix_profile"
  export PATH="$HOME/.local/bin:$BUN_INSTALL/bin:$PNPM_HOME:$MISE_DATA_DIR/shims:$nix_profile/bin:$inherited_path"
else
  export PATH="$HOME/.local/bin:$BUN_INSTALL/bin:$PNPM_HOME:$MISE_DATA_DIR/shims:$inherited_path"
fi

if [[ ! -f "$config_root/starship/starship.toml" ]]; then
  cp /app/share/code-studio/starship.toml "$config_root/starship/starship.toml"
fi

if ! cmp -s /app/share/code-studio/zshrc "$ZDOTDIR/.zshrc"; then
  zshrc_tmp="$(mktemp "$ZDOTDIR/.zshrc.tmp.XXXXXX")"
  cp /app/share/code-studio/zshrc "$zshrc_tmp"
  mv "$zshrc_tmp" "$ZDOTDIR/.zshrc"
fi

if [[ "$shell_mode" == "1" ]]; then
  if [[ "$#" -eq 0 ]]; then
    set -- -l
  fi
  exec /app/bin/zsh "$@"
fi

[[ -f "$user_settings_dir/settings.json" ]] || cp /app/share/code-studio/settings.json "$user_settings_dir/settings.json"
[[ -f "$user_data_dir/argv.json" ]] || cp /app/share/code-studio/argv.json "$user_data_dir/argv.json"
[[ -f "$user_settings_dir/locale.json" ]] || cp /app/share/code-studio/locale.json "$user_settings_dir/locale.json"

for arg in "$@"; do
  case "$arg" in
    --help|-h|--version|-v|--status|--list-extensions|--show-versions|--install-extension|--uninstall-extension|--update-extensions)
      cli_only=1
      ;;
  esac
done

if [[ "${1:-}" == "--print-code-studio-env" ]]; then
  env | grep -E '^(HOME|XDG_CONFIG_HOME|XDG_DATA_HOME|XDG_STATE_HOME|XDG_CACHE_HOME|GNUPGHOME|CODEX_HOME|GIT_CONFIG_GLOBAL|BUN_INSTALL|NPM_CONFIG_PREFIX|PNPM_HOME|PNPM_STORE_DIR|MISE_DATA_DIR|MISE_CONFIG_DIR|MISE_CACHE_DIR|ZDOTDIR|SHELL|LANG|LC_ALL|GIT_SSH_COMMAND|CODE_STUDIO_NIX_PROFILE|PATH)=' | sort
  for command_name in git gh gpg ssh gcc make python3 node npm pnpm bun mise starship fzf zoxide atuin eza bat fastfetch rg fd yazi codex opencode code-studio-shell; do
    command_path="$(command -v "$command_name" || true)"
    printf '%s=%s\n' "$command_name" "$command_path"
  done
  printf 'zsh_modules='
  /app/bin/zsh -fc 'zmodload zsh/regex && zmodload zsh/mathfunc && print ok' 2>/dev/null || true
  printf 'mise_shims='
  find "$MISE_DATA_DIR/shims" -mindepth 1 -maxdepth 1 -printf '.' 2>/dev/null | wc -c
  exit 0
fi

code_args=(
  "--user-data-dir=$user_data_dir"
  "--extensions-dir=$extensions_dir"
)

if [[ "$cli_only" != "1" ]]; then
  code_args+=(
    "--ozone-platform=wayland"
    "--no-sandbox"
    "--disable-crash-reporter"
  )

  if [[ "$#" -gt 0 ]]; then
    code_args+=(--new-window)
  fi
fi

if [[ "$cli_only" == "1" ]]; then
  exec /app/lib/vscode/bin/code "${code_args[@]}" "$@"
fi

exec /app/lib/vscode/code "${code_args[@]}" "$@"
